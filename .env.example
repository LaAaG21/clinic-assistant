# Local development only. Never reuse this password for a deployed database.
POSTGRES_USER=clinic
POSTGRES_PASSWORD=clinic-local-only
POSTGRES_DB=clinic
POSTGRES_PORT=5432
API_PORT=8000

# Host-side application and test connections. Compose supplies its own db hostname.
DATABASE_URL=postgresql://clinic:clinic-local-only@localhost:5432/clinic
TEST_DATABASE_URL=postgresql://clinic:clinic-local-only@localhost:5432/clinic

# No model API key is needed. The production LLM adapter is not implemented.

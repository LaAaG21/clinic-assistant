# Copy to .env and set your own local password. Never commit .env.
# Use URL-safe characters only (letters, digits, - and _).

# PostgreSQL service (read by compose.yaml and the postgres image)
POSTGRES_DB=clinic
POSTGRES_USER=clinic
POSTGRES_PASSWORD=change-me
# Port on your machine (bound to 127.0.0.1 only)
POSTGRES_PORT=5432

# Connection string for application code and tests on your machine.
# Keep user, password, port and database in sync with the values above.
DATABASE_URL=postgresql://clinic:change-me@127.0.0.1:5432/clinic

# API port on your machine (bound to 127.0.0.1 only); the container listens on 8000.
# Inside Compose the API builds its own DATABASE_URL with hostname db.
API_PORT=8000

# Database connection and statement timeout limits
DB_CONNECT_TIMEOUT_SECONDS=2
DB_QUERY_TIMEOUT_MS=1000

# Shared loader rules: docs/development/settings.md
# Required clinic calendar timezone. Example only: confirm with the clinic.
CLINIC_TIMEZONE=Asia/Dubai

# Configuration for the model adapter; fake mode needs no external API key.
MODEL_BACKEND=fake
# Set only when MODEL_BACKEND=openai. Never commit a real key.
OPENAI_API_KEY=
# Required only for the real backend. Choose a model available to your project.
OPENAI_MODEL=
# Integer 1..120 seconds; bounds the whole call, including SDK retries.
OPENAI_TIMEOUT_SECONDS=10
# Integer 0..2. Zero disables SDK retries.
OPENAI_MAX_RETRIES=0
